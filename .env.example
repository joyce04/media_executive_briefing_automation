# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...

# Naver Search API credentials (https://developers.naver.com)
# Required for Naver news collection. Create an application at developers.naver.com
# and enable the "검색" (Search) API.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Email recipients (referenced as ${VAR} in config/recipients.yaml)
KFA_EMAIL_TO_1=recipient@example.com
KFA_EMAIL_CC_1=
KFA_EMAIL_BCC_1=

# Tactics pipeline recipients (referenced as ${VAR} in config/tactics_recipients.yaml)
KFA_TACTICS_EMAIL_TO_1=recipient@example.com

# SMTP delivery settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=

# Database
DATABASE_PATH=./data/kfa_intel.db

# Report output
REPORTS_OUTPUT_DIR=./data/reports

# Logging
LOG_LEVEL=INFO

# Article freshness — drop RSS entries older than this many hours (default: 48)
# Increase if your sources publish slowly or you run the pipeline infrequently.
COLLECTION_MAX_AGE_HOURS=24

# Scheduler (Asia/Seoul timezone)
TIMEZONE=Asia/Seoul
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
